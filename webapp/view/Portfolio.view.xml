<mvc:View
	controllerName="mindtek.controller.Portfolio"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:cssgrid="sap.ui.layout.cssgrid"
>
	<Page id="portfolioPage" showHeader="false" showFooter="false" enableScrolling="true">
		<content>
			<VBox id="portfolioContent" class="mindtek-content">
				<VBox id="portfolioHeader" class="sapUiResponsiveMargin sapUiLargeMarginTop">
					<Title id="portfolioPageTitle" text="{i18n>workTitle}" titleStyle="H2" />
					<Text id="portfolioPageSubtitle" text="{i18n>workSubtitle}" class="sapUiTinyMarginTop" />
				</VBox>

				<VBox id="portfolioTileWrap" class="sapUiResponsiveMargin">
					<cssgrid:CSSGrid
						id="portfolioTiles"
						width="100%"
						items="{portfolio>/apps}"
						gridGap="{= ${portfolio>/phone} ? '0.5rem' : '1rem' }"
						gridTemplateColumns="{= ${portfolio>/phone} ? 'minmax(0, 1fr)' : 'repeat(auto-fit, minmax(15rem, 1fr))' }">
						<cssgrid:items>
							<GenericTile
								id="portfolioTile"
								header="{portfolio>title}"
								subheader="{= ${portfolio>/phone} ? ${portfolio>floorplan} + ' · ' + ${portfolio>status} : ${portfolio>floorplan} }"
								tooltip="{portfolio>description}"
								ariaLabel="{portfolio>ariaLabel}"
								width="100%"
								mode="{= ${portfolio>/phone} ? 'LineMode' : 'ContentMode' }"
								press=".onOpenApp">
								<tileContent>
									<TileContent id="portfolioTileContent" footer="{portfolio>status}">
										<content>
											<ImageContent id="portfolioTileIcon" src="{portfolio>icon}" />
										</content>
									</TileContent>
								</tileContent>
							</GenericTile>
						</cssgrid:items>
					</cssgrid:CSSGrid>
				</VBox>

				<core:Fragment fragmentName="mindtek.view.fragment.Footer" type="XML" />
			</VBox>
		</content>
	</Page>
</mvc:View>
