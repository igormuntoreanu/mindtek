<mvc:View
	controllerName="mindtek.controller.Portfolio"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:f="sap.f"
	xmlns:card="sap.f.cards"
	xmlns:cssgrid="sap.ui.layout.cssgrid"
>
	<Page id="portfolioPage" showHeader="false" showFooter="false" enableScrolling="true">
		<content>
			<VBox id="portfolioContent" class="mindtek-content">
				<VBox id="portfolioHeader" class="sapUiResponsiveMargin sapUiLargeMarginTop">
					<Title id="portfolioPageTitle" text="{i18n>workTitle}" level="H1" titleStyle="{= ${layout>/phone} ? 'H2' : 'H1' }" wrapping="true" wrappingType="Normal" width="100%" class="mindtek-page-title" />
					<Text id="portfolioPageSubtitle" text="{i18n>workSubtitle}" wrapping="true" class="sapUiTinyMarginTop" />
					<Text id="portfolioFictionalLabel" text="{i18n>portfolioFictionalData}" wrapping="true" class="sapUiSmallMarginTop" />
				</VBox>

				<!-- GenericTile subheader is one line and would clip the benefit sentences, so each demo is a card. The link is a real href that opens in a new tab. -->
				<VBox id="portfolioTileWrap" class="sapUiResponsiveMargin">
					<cssgrid:CSSGrid
						id="portfolioTiles"
						width="100%"
						items="{portfolio>/apps}"
						gridGap="1rem"
						gridTemplateColumns="{= ${layout>/phone} ? 'minmax(0, 1fr)' : 'repeat(auto-fit, minmax(18rem, 1fr))' }">
						<cssgrid:items>
							<f:Card class="mindtek-card mindtek-work-card">
								<f:header>
									<card:Header title="{portfolio>title}" />
								</f:header>
								<f:content>
									<VBox class="sapUiSmallMargin">
										<Text text="{portfolio>benefit}" wrapping="true" />
										<Text text="{portfolio>floorplan}" wrapping="true" class="mindtek-work-floorplan sapUiTinyMarginTop" />
										<Text text="{i18n>portfolioFictionalData}" wrapping="true" class="mindtek-work-floorplan sapUiTinyMarginTop" />
										<Link text="{i18n>portfolioOpenDemo}" href="{portfolio>url}" target="_blank" wrapping="true" class="sapUiSmallMarginTop" />
									</VBox>
								</f:content>
							</f:Card>
						</cssgrid:items>
					</cssgrid:CSSGrid>
				</VBox>

				<core:Fragment fragmentName="mindtek.view.fragment.Footer" type="XML" />
			</VBox>
		</content>
	</Page>
</mvc:View>
