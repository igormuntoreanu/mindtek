<mvc:View
	controllerName="mindtek.controller.Contact"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:form="sap.ui.layout.form"
>
	<Page id="contactPage" showHeader="false" showFooter="true" enableScrolling="true">
		<content>
			<VBox id="contactContent" class="mindtek-content">
			<VBox id="contactHeader" class="sapUiResponsiveMargin sapUiLargeMarginTop">
				<Title id="contactPageTitleText" text="{i18n>contactPageTitle}" titleStyle="H2" />
				<Text id="contactPageSubtitleText" text="{i18n>contactPageSubtitle}" class="sapUiTinyMarginTop" />
			</VBox>

			<Panel id="contactFormPanel" class="sapUiResponsiveMargin" width="auto">
				<form:SimpleForm
					id="contactForm"
					editable="true"
					layout="ResponsiveGridLayout"
					labelSpanXL="3"
					labelSpanL="3"
					labelSpanM="3"
					labelSpanS="12"
					adjustLabelSpan="false"
					emptySpanXL="4"
					emptySpanL="4"
					emptySpanM="4"
					emptySpanS="0"
					columnsXL="1"
					columnsL="1"
					columnsM="1"
				>
					<Label id="nameLabel" text="{i18n>formName}" required="true" labelFor="nameInput" />
					<Input id="nameInput" value="{form>/name}" placeholder="{i18n>formNamePlaceholder}" />

					<Label id="workEmailLabel" text="{i18n>formWorkEmail}" required="true" labelFor="workEmailInput" />
					<Input id="workEmailInput" type="Email" value="{form>/workEmail}" placeholder="{i18n>formWorkEmailPlaceholder}" />

					<Label id="companyLabel" text="{i18n>formCompany}" labelFor="companyInput" />
					<Input id="companyInput" value="{form>/company}" placeholder="{i18n>formCompanyPlaceholder}" />

					<Label id="projectTypeLabel" text="{i18n>formProjectType}" labelFor="projectTypeSelect" />
					<Select id="projectTypeSelect" selectedKey="{form>/projectType}" forceSelection="false" width="100%">
						<core:Item id="projectTypeItem1" key="{i18n>projectType1}" text="{i18n>projectType1}" />
						<core:Item id="projectTypeItem2" key="{i18n>projectType2}" text="{i18n>projectType2}" />
						<core:Item id="projectTypeItem3" key="{i18n>projectType3}" text="{i18n>projectType3}" />
						<core:Item id="projectTypeItem4" key="{i18n>projectType4}" text="{i18n>projectType4}" />
						<core:Item id="projectTypeItem5" key="{i18n>projectType5}" text="{i18n>projectType5}" />
						<core:Item id="projectTypeItem6" key="{i18n>projectType6}" text="{i18n>projectType6}" />
						<core:Item id="projectTypeItem7" key="{i18n>projectType7}" text="{i18n>projectType7}" />
					</Select>

					<Label id="requirementLabel" text="{i18n>formRequirement}" required="true" labelFor="requirementInput" />
					<TextArea id="requirementInput" value="{form>/requirement}" rows="4" width="100%" placeholder="{i18n>formRequirementPlaceholder}" />
				</form:SimpleForm>

				<Text id="privacyNoticeText" text="{i18n>contactPrivacyLine}" class="sapUiSmallMarginTop" wrapping="true" />

				<HBox id="contactEmailRow" class="sapUiTinyMarginTop" wrap="Wrap">
					<Text id="contactEmailLabelText" text="{i18n>contactEmailLabel}" class="sapUiTinyMarginEnd" />
					<Text id="contactEmailValueText" text="{i18n>companyContactEmail}" />
				</HBox>
			</Panel>

			<core:Fragment fragmentName="mindtek.view.fragment.Footer" type="XML" />

			</VBox>
		</content>
		<footer>
			<OverflowToolbar id="contactFormToolbar">
				<ToolbarSpacer />
				<Button id="clearFormButton" text="{i18n>formClear}" type="Transparent" press=".onClearForm" />
				<Button id="submitFormButton" text="{i18n>formSubmit}" type="Emphasized" icon="sap-icon://email" press=".onSubmitRequest" />
			</OverflowToolbar>
		</footer>
	</Page>
</mvc:View>
