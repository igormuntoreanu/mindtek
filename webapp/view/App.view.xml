<mvc:View
	controllerName="mindtek.controller.App"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	height="100%"
>
	<VBox id="appShell" fitContainer="true">
		<OverflowToolbar id="appShellBar" design="Transparent" width="100%" class="mindtek-shellbar">
			<Image id="appShellBarLogoLeft" src="assets/mindtek-logo-white.jpeg" height="2.5rem" densityAware="false" decorative="false" alt="MindTek logo" press=".onNavToHome">
				<layoutData>
					<OverflowToolbarLayoutData priority="NeverOverflow" />
				</layoutData>
			</Image>
			<ToolbarSpacer />
			<Button id="navHomeButton" class="mindtek-nav-btn" text="{i18n>navHome}" type="{= ${nav>/currentRoute} === 'home' ? 'Emphasized' : 'Transparent'}" press=".onNavToHome" />
			<Button id="navAboutButton" class="mindtek-nav-btn" text="{i18n>navAbout}" type="{= ${nav>/currentRoute} === 'about' ? 'Emphasized' : 'Transparent'}" press=".onNavToAbout" />
			<Button id="navPortfolioButton" class="mindtek-nav-btn" text="{i18n>navPortfolio}" type="{= ${nav>/currentRoute} === 'portfolio' ? 'Emphasized' : 'Transparent'}" press=".onNavToPortfolio" />
			<Button id="navContactButton" class="mindtek-nav-btn" text="{i18n>navContact}" type="{= ${nav>/currentRoute} === 'contact' ? 'Emphasized' : 'Transparent'}" press=".onNavToContact" />
			<ToolbarSpacer />
			<Image id="appShellBarLogoRight" class="mindtek-logo-right" src="assets/mindtek-logo-white.jpeg" height="2.5rem" densityAware="false" decorative="false" alt="MindTek logo" press=".onNavToHome" />
		</OverflowToolbar>
		<App id="app">
			<NavContainer id="appNavContainer" />
		</App>
		<HBox
			id="cookieBanner"
			class="mindtek-cookie-banner"
			visible="false"
			alignItems="Center"
			justifyContent="SpaceBetween"
			wrap="Wrap">
			<VBox id="cookieBannerTextWrap" class="sapUiTinyMargin" alignItems="Start">
				<Text id="cookieBannerText" text="{i18n>cookieBannerText}" wrapping="true" />
			</VBox>
			<HBox id="cookieBannerActions" class="sapUiTinyMargin" wrap="Wrap">
				<Button id="cookieBannerAcceptButton" text="{i18n>cookieBannerAccept}" type="Emphasized" press=".onCookieBannerAccept" class="sapUiTinyMarginEnd" />
				<Button id="cookieBannerPrivacyButton" text="{i18n>cookieBannerPrivacy}" type="Transparent" press=".onCookieBannerPrivacy" />
			</HBox>
		</HBox>
		<Dialog id="privacyDialog" title="{i18n>privacyNoticeTitle}" contentWidth="38rem" resizable="false">
			<content>
				<VBox id="privacyDialogContent" class="sapUiMediumMargin">
					<Text id="privacyNoticeText1" text="{i18n>privacyNoticeText1}" wrapping="true" class="sapUiTinyMarginBottom" />
					<Text id="privacyNoticeText2" text="{i18n>privacyNoticeText2}" wrapping="true" class="sapUiTinyMarginBottom" />
					<Text id="privacyNoticeText3" text="{i18n>privacyNoticeText3}" wrapping="true" class="sapUiTinyMarginBottom" />
					<Text id="privacyNoticeText4" text="{i18n>privacyNoticeText4}" wrapping="true" />
				</VBox>
			</content>
			<beginButton>
				<Button id="privacyDialogCloseButton" text="{i18n>privacyNoticeClose}" press=".onPrivacyDialogClose" />
			</beginButton>
		</Dialog>
	</VBox>
</mvc:View>
