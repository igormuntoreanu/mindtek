<mvc:View
	controllerName="mindtek.controller.App"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	height="100%"
>
	<VBox id="appShell" class="mindtek-shell" fitContainer="true">
		<dependents>
			<Popover id="navPopover" placement="Bottom" showHeader="false" contentWidth="14rem">
				<content>
					<List id="navMenuList" showSeparators="None">
						<CustomListItem id="navHomeMenuItem" type="Inactive">
							<Link id="navHomeMenuLink" href="/" text="{i18n>navHome}" press=".onNavMenuSelect" width="100%" class="mindtek-nav-menu-link">
								<customData><core:CustomData key="route" value="home" /></customData>
							</Link>
						</CustomListItem>
						<CustomListItem id="navAboutMenuItem" type="Inactive">
							<Link id="navAboutMenuLink" href="/about/" text="{i18n>navAbout}" press=".onNavMenuSelect" width="100%" class="mindtek-nav-menu-link">
								<customData><core:CustomData key="route" value="about" /></customData>
							</Link>
						</CustomListItem>
						<CustomListItem id="navPeopleMenuItem" type="Inactive">
							<Link id="navPeopleMenuLink" href="/people/" text="{i18n>navPeople}" press=".onNavMenuSelect" width="100%" class="mindtek-nav-menu-link">
								<customData><core:CustomData key="route" value="people" /></customData>
							</Link>
						</CustomListItem>
						<CustomListItem id="navWorkMenuItem" type="Inactive">
							<Link id="navWorkMenuLink" href="/work/" text="{i18n>navWork}" press=".onNavMenuSelect" width="100%" class="mindtek-nav-menu-link">
								<customData><core:CustomData key="route" value="work" /></customData>
							</Link>
						</CustomListItem>
					</List>
				</content>
			</Popover>
		</dependents>
		<Link id="skipToMain" text="{i18n>skipToMain}" href="#main" press=".onSkipToMain" class="mindtek-skip-link" />
		<OverflowToolbar id="appShellBar" design="Solid" width="100%" class="mindtek-shellbar">
			<Image id="appShellBarLogo" src="assets/mindtek-logo-white.jpeg" height="2.75rem" densityAware="false" decorative="false" alt="{i18n>logoAlt}" tooltip="{i18n>logoTooltip}" press=".onNavToHome">
				<layoutData>
					<OverflowToolbarLayoutData priority="NeverOverflow" />
				</layoutData>
			</Image>
			<Button id="navMenuButton" icon="sap-icon://menu2" type="Transparent" tooltip="{i18n>navMenu}" press=".onToggleNavMenu" visible="{layout>/phone}" ariaHasPopup="Menu" class="mindtek-nav-menu-button">
				<layoutData>
					<OverflowToolbarLayoutData priority="NeverOverflow" />
				</layoutData>
			</Button>
			<ToolbarSpacer id="appShellBarSpacer">
				<layoutData>
					<OverflowToolbarLayoutData priority="NeverOverflow" shrinkable="true" />
				</layoutData>
			</ToolbarSpacer>
			<Link id="navHomeLink" href="/" text="{i18n>navHome}" press=".onSeoNav" class="mindtek-nav-link" visible="{= !${layout>/phone} }">
				<customData>
					<core:CustomData key="route" value="home" />
				</customData>
				<layoutData>
					<OverflowToolbarLayoutData priority="NeverOverflow" />
				</layoutData>
			</Link>
			<Link id="navAboutLink" href="/about/" text="{i18n>navAbout}" press=".onSeoNav" class="mindtek-nav-link" visible="{= !${layout>/phone} }">
				<customData>
					<core:CustomData key="route" value="about" />
				</customData>
				<layoutData>
					<OverflowToolbarLayoutData priority="NeverOverflow" />
				</layoutData>
			</Link>
			<Link id="navPeopleLink" href="/people/" text="{i18n>navPeople}" press=".onSeoNav" class="mindtek-nav-link" visible="{= !${layout>/phone} }">
				<customData>
					<core:CustomData key="route" value="people" />
				</customData>
				<layoutData>
					<OverflowToolbarLayoutData priority="NeverOverflow" />
				</layoutData>
			</Link>
			<Link id="navWorkLink" href="/work/" text="{i18n>navWork}" press=".onSeoNav" class="mindtek-nav-link" visible="{= !${layout>/phone} }">
				<customData>
					<core:CustomData key="route" value="work" />
				</customData>
				<layoutData>
					<OverflowToolbarLayoutData priority="NeverOverflow" />
				</layoutData>
			</Link>
			<Button id="headerCtaButton" text="{i18n>headerCtaButton}" type="Emphasized" press=".onNavToContact" class="mindtek-header-cta">
				<layoutData>
					<OverflowToolbarLayoutData priority="NeverOverflow" />
				</layoutData>
			</Button>
		</OverflowToolbar>
		<App id="app" class="mindtek-app" autoFocus="false" afterNavigate=".onAfterNavigate">
			<layoutData>
				<FlexItemData growFactor="1" minHeight="0" />
			</layoutData>
		</App>
		<HBox
			id="cookieBanner"
			class="mindtek-cookie-banner"
			alignContent="Center"
			alignItems="Center"
			direction="ColumnReverse"
			wrap="Wrap">
			<VBox id="cookieBannerTextWrap" class="mindtek-cookie-text" alignItems="Start">
				<Text id="cookieBannerText" text="{i18n>cookieBannerText}" wrapping="true" />
			</VBox>
			<HBox id="cookieBannerActions" class="mindtek-cookie-actions" alignItems="Center" gap="1rem">
				<Button id="cookieBannerPrivacyButton" text="{i18n>cookieBannerPrivacy}" type="Default" press=".onCookieBannerPrivacy" />
				<Button id="cookieBannerAcceptButton" text="{i18n>cookieBannerAccept}" type="Emphasized" press=".onCookieBannerAccept" />
			</HBox>
		</HBox>
		<Dialog id="privacyDialog" title="{i18n>privacyNoticeTitle}" type="Message" contentWidth="38rem" resizable="false">
			<content>
				<VBox id="privacyDialogContent" class="sapUiSmallMargin">
					<Text id="privacyNoticeText1" text="{i18n>privacyNoticeText1}" wrapping="true" class="sapUiTinyMarginBottom" />
					<Text id="privacyNoticeText2" text="{i18n>privacyNoticeText2}" wrapping="true" class="sapUiTinyMarginBottom" />
					<Text id="privacyNoticeText3" text="{i18n>privacyNoticeText3}" wrapping="true" class="sapUiTinyMarginBottom" />
					<Text id="privacyNoticeText4" text="{i18n>privacyNoticeText4}" wrapping="true" />
				</VBox>
			</content>
			<beginButton>
				<Button id="privacyDialogCloseButton" text="{i18n>privacyNoticeClose}" press=".onPrivacyDialogClose" />
			</beginButton>
		</Dialog>
	</VBox>
</mvc:View>
