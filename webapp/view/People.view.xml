<mvc:View
	controllerName="mindtek.controller.People"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
>
	<Page id="peoplePage" showHeader="false" showFooter="false" enableScrolling="true">
		<content>
			<VBox id="peopleContent" class="mindtek-content">
				<VBox id="peopleHeader" class="sapUiResponsiveMargin sapUiLargeMarginTop">
					<Title id="peoplePageTitleText" text="{i18n>peopleTitle}" level="H1" titleStyle="{= ${layout>/phone} ? 'H2' : 'H1' }" wrapping="true" wrappingType="Normal" width="100%" class="mindtek-page-title" />
					<Text id="peoplePageSubtitleText" text="{i18n>peopleSubtitle}" wrapping="true" class="sapUiTinyMarginTop" />
				</VBox>
				<VBox id="peopleCardsWrap" class="sapUiResponsiveMargin">
					<core:Fragment fragmentName="mindtek.view.fragment.PeopleCards" type="XML" />
				</VBox>
				<VBox id="peopleCtaContent" class="sapUiResponsiveMargin sapUiLargeMarginTop" alignItems="Center">
					<Title id="peopleCtaTitle" text="{i18n>ctaTitle}" level="H2" titleStyle="H3" wrapping="true" textAlign="Center" width="100%" />
					<Text id="peopleCtaText" text="{i18n>companyClosingStatement}" textAlign="Center" wrapping="true" class="sapUiSmallMarginTop" />
					<Button id="peopleCtaButton" text="{i18n>ctaButton}" type="Emphasized" press=".onNavToContact" class="sapUiMediumMarginTop" />
				</VBox>
				<core:Fragment fragmentName="mindtek.view.fragment.Footer" type="XML" />
			</VBox>
		</content>
	</Page>
</mvc:View>
